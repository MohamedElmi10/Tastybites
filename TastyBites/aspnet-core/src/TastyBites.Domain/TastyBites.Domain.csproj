<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>TastyBites</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TastyBites.Domain.Shared\TastyBites.Domain.Shared.csproj" />
  </ItemGroup>

  <!-- why: embedded in the DLL, so the seeder finds its data wherever DbMigrator runs (no file path to get wrong).
       LogicalName fixes the resource name instead of relying on folder-based naming. -->
  <ItemGroup>
    <EmbeddedResource Include="Recipes\Seed\recipe-seed-data.json" LogicalName="TastyBites.Recipes.recipe-seed-data.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Emailing" Version="7.4.5" />
    <PackageReference Include="Volo.Abp.Identity.Domain" Version="7.4.5" />
    <PackageReference Include="Volo.Abp.PermissionManagement.Domain.Identity" Version="7.4.5" />
    <PackageReference Include="Volo.Abp.BackgroundJobs.Domain" Version="7.4.5" />
    <PackageReference Include="Volo.Abp.AuditLogging.Domain" Version="7.4.5" />
    <PackageReference Include="Volo.Abp.TenantManagement.Domain" Version="7.4.5" />
    <PackageReference Include="Volo.Abp.FeatureManagement.Domain" Version="7.4.5" />
    <PackageReference Include="Volo.Abp.SettingManagement.Domain" Version="7.4.5" />
    <PackageReference Include="Volo.Abp.OpenIddict.Domain" Version="7.4.5" />
    <PackageReference Include="Volo.Abp.PermissionManagement.Domain.OpenIddict" Version="7.4.5" />
  </ItemGroup>

</Project>
